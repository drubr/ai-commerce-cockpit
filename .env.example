# Defaults to localhost. Set to the actual origin when hosting elsewhere.
BETTER_AUTH_URL=http://localhost:3000
# Optional locally: setup generates a persistent random secret in .data/auth-secret.
# BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Email OTP delivery (Resend, using a verified sender).
RESEND_API_KEY=
OTP_FROM_EMAIL=
# Local development only: write real OTPs to private .data/otp/<user-id>.json.
# OTP_DELIVERY=file
